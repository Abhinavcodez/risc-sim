{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",
                "/usr/local/include",
                "/usr/include/c++/11",                     // GCC C++ headers
                "/usr/include/x86_64-linux-gnu/c++/11",    // GCC libstdc++ headers
                "/usr/include/x86_64-linux-gnu",           // System headers
                "/usr/include/linux",                       // Linux kernel headers
                "/usr/include/asm-generic"                 // Generic asm headers
            ],
            "defines": [],
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.makefile-tools"
        }
    ],
    "version": 4
}